rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Leaderboard (global all-time) ───────────────────────────────────────
    // Anyone can read. Only authenticated users can submit their own scores.
    match /leaderboard/{entry} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.initials is string
        && request.resource.data.initials.size() == 3;

      // Scores are immutable once written
      allow update, delete: if false;
    }

    // ── Weekly Leaderboard ───────────────────────────────────────────────────
    match /leaderboard_weekly/{entry} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.initials is string
        && request.resource.data.initials.size() == 3
        && request.resource.data.weekKey is string;

      allow update, delete: if false;
    }

    // ── Daily Leaderboard ────────────────────────────────────────────────────
    match /leaderboard_daily/{entry} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 10000
        && request.resource.data.initials is string
        && request.resource.data.initials.size() == 3
        && request.resource.data.date is string;

      allow update, delete: if false;
    }

    // ── User Profiles ────────────────────────────────────────────────────────
    // Each user can only read and write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
